<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UnionTypesEnabled>true</UnionTypesEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnionTypes.Runtime\UnionTypes.Runtime.csproj" />
  </ItemGroup>

  <!-- Source/ contains union-syntax input for the transpiler, NOT valid C#.
       Exclude it from compilation so the project builds and the IDE stays clean. -->
  <ItemGroup>
    <Compile Remove="Source\**\*.cs" />
    <None Include="Source\**\*.cs" />
  </ItemGroup>

</Project>
